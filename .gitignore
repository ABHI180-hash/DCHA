# ==========================================
# Indian Cultural Heritage Archive (DCHA)
# Git Ignore Configuration
# ==========================================

# Java / Maven build outputs
target/
**/target/
*.class

# Maven wrapper jar exception
*.jar
*.war
!backend-spring/.mvn/wrapper/maven-wrapper.jar

# Node.js dependencies & logs
node_modules/
**/node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Temporary verification screenshots in frontend root
frontend/*.png

# Logs, test traces & error dumps
*.log
**/logs/
error*.txt
test-endpoints.js

# Environment variables & local secrets
.env
.env.*
!.env.example
application-local.properties
application-secret.properties

# Local database files
*.mv.db
*.trace.db

# IDE & Editor caches
.idea/
*.iml
.DS_Store
Thumbs.db

# Temporary scratchpad
scratch/
